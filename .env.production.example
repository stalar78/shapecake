APP_ENV=production

POSTGRES_USER=shape_cake
POSTGRES_PASSWORD=<set-a-strong-random-value>
POSTGRES_DB=shape_cake
DATABASE_URL=postgresql+asyncpg://shape_cake:<set-a-strong-random-value>@postgres:5432/shape_cake

SESSION_COOKIE_NAME=shape_cake_session
SESSION_HASH_PEPPER=<set-a-strong-random-value>
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=.example.com

ALLOWED_FRONTEND_ORIGINS=https://example.com,https://admin.example.com

PUBLIC_API_BASE_URL=http://api:8000/api
NEXT_PUBLIC_API_BASE_URL=https://example.com/api
VITE_ADMIN_API_BASE_URL=https://admin.example.com/api

PUBLIC_SITE_ORIGIN=https://example.com
NEXT_PUBLIC_SITE_ORIGIN=https://example.com
PUBLIC_MEDIA_ORIGIN=https://example.com

NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

MEDIA_ROOT=/app/storage/media
MEDIA_PUBLIC_BASE_URL=/api/media
MAX_UPLOAD_BYTES=5242880
