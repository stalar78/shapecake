APP_ENV=development

POSTGRES_USER=shape_cake
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shape_cake
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shape_cake:change-me@postgres:5432/shape_cake
TEST_DATABASE_URL=postgresql+asyncpg://shape_cake:change-me@localhost:5432/shape_cake_test

SESSION_COOKIE_NAME=shape_cake_session
SESSION_HASH_PEPPER=replace-with-a-long-random-secret
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
VITE_ADMIN_API_BASE_URL=http://localhost:8000/api
